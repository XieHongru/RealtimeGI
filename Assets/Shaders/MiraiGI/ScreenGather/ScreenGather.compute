#include "../VoxelLighting/VoxelLightingParameters.hlsl"
#include "../RayTracing/MonteCarlo.hlsl"
#include "../RayTracing/SSRTRayCast.hlsl"
#include "ReservoirSampling.hlsl"
#include "../RayTracing/BRDF.hlsl"

// -------------------------------------------------------------------------------- //
#ifndef TRACE_SPECULAR_RAY
#define TRACE_SPECULAR_RAY 0
#endif

#define SPECULAR_USE_CLAMPED_BRDF 1
#define SPECULAR_BRDF_BIAS (0.6f)

#define FORCE_VOXEL_TRACE 1

#define INDEX_CENTER (0)
static const int2 offsets3x3[9] = { int2(0, 0), int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1), int2(-1, -1), int2(-1, 1), int2(1, -1), int2(1, 1) };
static const float gaussianWeights3x3[9] = { 0.25, 0.0625, 0.125, 0.0625, 0.125, 0.125, 0.0625, 0.125, 0.0625 };

uint _FrameNumber;
int2 _ScreenGatherRTSize;

SamplerState sampler_PointClamp;
Texture2D<float4> _NormalDepthTexture;
Texture2D<float4> _NormalDepthHistory;

Texture2D<float4> _GBufferNormal;

float4 _ScreenPositionScaleBias;
float4x4 _ClipToPrevClip;

// View Params
float4 _CameraPosition;
float4x4 _ViewMat;
float4x4 _ProjMat;
float4x4 _TranslatedWorldToView;
float4x4 _TranslatedWorldToClip;
float4 _ZBufferParam;
float4x4 _InvProjMat;
float4x4 _InvViewMat;
float4x4 _WorldToClip;

float ConvertFromDeviceZ(float rawDepth)
{
    float reverseDepth = 1 - rawDepth;
    return 1.0 / (_ZBufferParam.z * reverseDepth + _ZBufferParam.w);
}

float3 ReconstructWorldPositionFromDepth(float2 uv, float depth)
{
    float eyeDepth = ConvertFromDeviceZ(depth);
    float4 clipPos = float4(uv * 2.0 - 1.0, (1.0 - depth) * 2.0 - 1.0, 1.0);
    float4 viewPos = mul(_InvProjMat, clipPos);
    viewPos /= viewPos.w;
    
    float4 worldPos = mul(_InvViewMat, viewPos);
    
    return worldPos.xyz;
}

float3 WorldToScreen(float3 worldPosition)
{
    float4 clipPos = mul(_WorldToClip, float4(worldPosition, 1));
    clipPos.xyz /= clipPos.w;

    float2 sceneUV = float2((clipPos.x + 1) * 0.5, 1 - (clipPos.y + 1) * 0.5);

    return float3(sceneUV, clipPos.z);
}

float4 SetupPixelRandom(float2 uv)
{
    uint2 randomSeed1 = Rand3DPCG16(uint3(uv * 1919.114, _FrameNumber)).xy;
    uint2 randomSeed2 = Rand3DPCG16(uint3(uv * 810.514, _FrameNumber)).xy;
    float2 E1 = Hammersley16(0, 1, randomSeed1);
    float2 E2 = Hammersley16(0, 1, randomSeed2);

    return float4(E1, E2);
}

float4 SetupDiffuseRay(float3 worldNormal, float2 E)
{
    float3x3 tangentBasis = GetTangentBasis(worldNormal);
#if TARGET_PDF_WITH_COSINE
    float4 tangentL = CosineSampleHemisphere(E);
#else
    float4 tangentL = UniformSampleHemisphere(E);
#endif
    float3 rayDirection = mul(tangentBasis, tangentL.xyz);
    float samplePDF = max(tangentL.w, 1e-3);
    
    return float4(rayDirection, samplePDF);
}

float4 SetupSpecularRay(float3 worldPosition, float3 worldNormal, float2 E, float roughness)
{
    // note : we clamp brdf to focus ray approach mirror direction, reduce niose in high roughness
    // note2: cause we using ratio estimator (a fancy weight sum) in specular resolve pass
    //        so we don't force integrate of PDF to be 1.0 (PDF will be normalized at resolve pass)
#if SPECULAR_USE_CLAMPED_BRDF
    E.x *= 1.0 - SPECULAR_BRDF_BIAS;
#endif

    float3x3 tangentBasis = GetTangentBasis(worldNormal);
    float3 V = normalize(_CameraPosition - worldPosition);
    float3 tangentV = mul(V, tangentBasis);

    float a2 = roughness * roughness * roughness * roughness;
    float4 tangentH = ImportanceSampleVisibleGGX(UniformSampleDisk(E), a2, tangentV);
    float3 H = mul(tangentBasis, tangentH.xyz);
    
    float samplePDF = max(tangentH.w, 1e-3);
    float3 rayDirection = 2 * dot(V, H) * H - V;
    // rayDirection = reflect(V, worldNormal); // for debug

    return float4(rayDirection, samplePDF);
}

float2 ReprojectPixel(float3 uvz)
{
    float2 thisScreen = (uvz.xy - _ScreenPositionScaleBias.wz) / _ScreenPositionScaleBias.xy;
    float4 thisClip = float4(thisScreen, uvz.z, 1);
    float4 prevClip = mul(_ClipToPrevClip, thisClip);
    float2 prevScreen = prevClip.xy / prevClip.w;
    float2 prevUV = prevScreen.xy * _ScreenPositionScaleBias.xy + _ScreenPositionScaleBias.wz;
    return prevUV;
}

struct PixelContext
{
    float3 worldPosition;
    float3 worldNormal;
    float rawDepth;
    float sceneDepth;
    float4 randomVector;
    float4 rayDirection;
    float roughness;
};

// per pixel ray trace info shared by multiple pass
PixelContext ResolvePixelContext(float2 uv)
{
    PixelContext pixelCtx = (PixelContext) 0;

    float4 normalDepth = _NormalDepthTexture.SampleLevel(sampler_PointClamp, uv, 0);
    pixelCtx.rawDepth = normalDepth.w;
    pixelCtx.sceneDepth = ConvertFromDeviceZ(pixelCtx.rawDepth);
    pixelCtx.worldPosition = ReconstructWorldPositionFromDepth(uv, pixelCtx.rawDepth);
    pixelCtx.worldNormal = normalDepth.rgb * 2 - 1;
    pixelCtx.randomVector = SetupPixelRandom(uv);

#if TRACE_SPECULAR_RAY
    pixelCtx.roughness = max(_GBufferNormal.SampleLevel(sampler_PointClamp, uv, 0).w, 0.01);
    pixelCtx.rayDirection = SetupSpecularRay(pixelCtx.worldPosition, pixelCtx.worldNormal, pixelCtx.randomVector.xy, pixelCtx.roughness);
#else
    pixelCtx.rayDirection = SetupDiffuseRay(pixelCtx.worldNormal, pixelCtx.randomVector.xy);
#endif

    return pixelCtx;
}

float GetPixelPositionAndNormal(float2 uv, inout float3 outPosition, inout float3 outNormal)
{
    float4 normalDepth = _NormalDepthTexture.SampleLevel(sampler_PointClamp, uv, 0);
    outPosition = ReconstructWorldPositionFromDepth(uv, normalDepth.w);
    outNormal = normalDepth.xyz * 2 - 1;
    return ConvertFromDeviceZ(normalDepth.w);
}

#define ClampNaNs(color) (-min(-color, 0.0))

#define Luma(color) (dot(color, float3(0.2126, 0.7152, 0.0722)))

#define max2(a) (max(a.x, a.y))

// -------------------------------------------------------------------------------- //
#pragma kernel NormalDepthDownsample

uint2 _SceneTextureRTSize;

Texture2D<float> _SceneDepthTexture;
RWTexture2D<float4> _RWNormalDepthTexture;

[numthreads(8, 8, 1)]
void NormalDepthDownsample(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    const int2 pixelCoord = clamp(threadId.xy, 0, _ScreenGatherRTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_ScreenGatherRTSize);
    
    float2 sampleCoords[4];
    sampleCoords[0] = min(pixelCoord * 2 + uint2(0, 0), _SceneTextureRTSize - 1);
    sampleCoords[1] = min(pixelCoord * 2 + uint2(0, 1), _SceneTextureRTSize - 1);
    sampleCoords[2] = min(pixelCoord * 2 + uint2(1, 0), _SceneTextureRTSize - 1);
    sampleCoords[3] = min(pixelCoord * 2 + uint2(1, 1), _SceneTextureRTSize - 1);

    float4 samples[4];
    for (uint i = 0; i < 4; ++i)
    {
        samples[i].rgb = _GBufferNormal.Load(uint3(sampleCoords[i], 0)).rgb * 0.5f + 0.5f;
        samples[i].a = _SceneDepthTexture.Load(uint3(sampleCoords[i], 0)).r;
    }
	
    float maxDepth = max(max(samples[0].a, samples[1].a), max(samples[2].a, samples[3].a));

    float4 avgColor = 0.0001f;
    for (uint i = 0; i < 4; ++i)
    {
        float depthA = ConvertFromDeviceZ(samples[i].a);
        float depthB = ConvertFromDeviceZ(maxDepth);
        float weight = saturate(1 - abs(depthA - depthB) * 0.01);
        avgColor += float4(samples[i].rgb, 1) * weight;
    }
    avgColor.rgb /= avgColor.w;

    _RWNormalDepthTexture[threadId.xy] = float4(avgColor.rgb, maxDepth);
}

// -------------------------------------------------------------------------------- //
#pragma kernel InitialSampleScreenTrace

#define TILE_SIZE uint2(8, 8)

float4 _HZBUvFactorAndInvFactor;

Texture2D _HZB;
Texture2D<float4> _SceneColorHistory;
RWTexture2D<float4> _RWInitialSampleRadiance;
RWTexture2D<float4> _RWInitialSampleHitInfo;

RWStructuredBuffer<int> _RWVoxelTraceRayCounter;
RWStructuredBuffer<int2> _RWVoxelTraceRayCompactBuffer;

groupshared bool gs_PixelValidMask[64];
groupshared bool gs_ScreenHitMask[64];
groupshared int gs_CompactBufferWriteIndex[64];

[numthreads(8, 8, 1)]
void InitialSampleScreenTrace(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    // 1. do some setup
    const int groupThreadIndex = Index2DTo1D(threadId.xy % TILE_SIZE, TILE_SIZE);
    const int2 pixelCoord = clamp(threadId.xy, 0, _ScreenGatherRTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_ScreenGatherRTSize);
    
    PixelContext pixelCtx = ResolvePixelContext(uv);
    const bool isValidPixel = all(threadId.xy < _ScreenGatherRTSize - 1) && pixelCtx.rawDepth > 0;

    // 2. trace screen ray
    const int numSteps = 32;
    float3 hitUVz = float3(0, 0, 0);
    float hitLevel = 0;
    float3 rayOriginTranslatedWorld = pixelCtx.worldPosition - _CameraPosition;

    bool isHit = RayCast(
        _HZB, sampler_PointClamp,
        rayOriginTranslatedWorld, pixelCtx.rayDirection,
        0.05, // roughness 
        pixelCtx.sceneDepth,
        numSteps,
        pixelCtx.randomVector.z, // SSRStepOffset
        _HZBUvFactorAndInvFactor,
        false, // debug print
        _TranslatedWorldToClip, _ProjMat,
        _ScreenPositionScaleBias,
        hitUVz, hitLevel
    );

#if FORCE_VOXEL_TRACE
    isHit = false;
#endif
    
    float2 reprojectRayHitUV = ReprojectPixel(hitUVz);
    float3 rayEndPosition = ReconstructWorldPositionFromDepth(hitUVz.xy, hitUVz.z);
    float rayDistance = length(rayEndPosition - pixelCtx.worldPosition);

    // calculate scene color sample mip level to simulate glossy reflection
#if TRACE_SPECULAR_RAY && SPECULAR_USE_CLAMPED_BRDF
    float3 V = normalize(_CameraPosition - pixelCtx.worldPosition);
    float NdotV = saturate(dot(pixelCtx.worldNormal, V));
    float coneTangent = lerp(0.0, pixelCtx.roughness * (1.0 - SPECULAR_BRDF_BIAS), NdotV * sqrt(pixelCtx.roughness));
    float rayDistanceScreenSpace = length(hitUVz.xy - uv) * max2(_ScreenGatherRTSize);
    hitLevel = clamp(log2(coneTangent * rayDistanceScreenSpace), 0, 8);
#endif

    // 3. fetch radiance
    float3 hitRadiance = float3(0, 0, 0);
    float3 hitNormal = float3(0, 0, 0);
    if (isHit)
    {
        hitRadiance = _SceneColorHistory.SampleLevel(sampler_linearClamp, reprojectRayHitUV, 0).rgb;
        //hitRadiance = _SceneColorHistory.SampleLevel(sampler_linearClamp, reprojectRayHitUV, hitLevel).rgb;
        hitNormal = _NormalDepthHistory.SampleLevel(sampler_PointClamp, reprojectRayHitUV, 0).rgb * 2 - 1;
        
        // discard back face hit
        if (dot(hitNormal, pixelCtx.rayDirection) > 0)
        {
            isHit = false;
        }
    }

    if (isValidPixel)
    {
        _RWInitialSampleRadiance[pixelCoord] = float4(hitRadiance, isHit);
        _RWInitialSampleHitInfo[pixelCoord] = float4(hitNormal * 0.5 + 0.5, rayDistance);
    }
    else
    {
        _RWInitialSampleRadiance[pixelCoord] = float4(0, 0, 0, 0);
        _RWInitialSampleHitInfo[pixelCoord] = float4(0, 0, 0, 0);
    }

    gs_PixelValidMask[groupThreadIndex] = isValidPixel;
    gs_ScreenHitMask[groupThreadIndex] = isHit;

    GroupMemoryBarrierWithGroupSync();

    // 4. single head thread count missing ray for off screen voxel trace
    if (groupThreadIndex == 0)
    {
        // 4.1. count ray
        int rayCounter = 0;
        for (int i = 0; i < 64; i++)
        {
            if (!gs_ScreenHitMask[i] && gs_PixelValidMask[i])
            {
                rayCounter += 1;
            }
        }
        
        // 4.2. allocate space in compact buffer
        int writeIndex = 0;
        InterlockedAdd(_RWVoxelTraceRayCounter[0], rayCounter, writeIndex);

        // 4.3. boardcast thread write index
        for (int i = 0; i < 64; i++)
        {
            if (!gs_ScreenHitMask[i] && gs_PixelValidMask[i])
            {
                gs_CompactBufferWriteIndex[i] = writeIndex;
                writeIndex += 1;
            }
        }
    }

    GroupMemoryBarrierWithGroupSync();

    // 5. write pixel info to buffer
    if (!isHit && isValidPixel)
    {
        int writeIndex = gs_CompactBufferWriteIndex[groupThreadIndex];
        _RWVoxelTraceRayCompactBuffer[writeIndex] = pixelCoord;
    }
}

// -------------------------------------------------------------------------------- //
#pragma kernel BuildVoxelTraceIndirectArgs

int _NumThreadsForVoxelTrace;
StructuredBuffer<int> _VoxelTraceRayCounter;
RWStructuredBuffer<int> _RWIndirectArgs;

[numthreads(1, 1, 1)]
void BuildVoxelTraceIndirectArgs(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    _RWIndirectArgs[0] = ceil(float(_VoxelTraceRayCounter[0]) / float(_NumThreadsForVoxelTrace));
    _RWIndirectArgs[1] = 1;
    _RWIndirectArgs[2] = 1;
}

// -------------------------------------------------------------------------------- //
#pragma kernel InitialSampleVoxelTrace

StructuredBuffer<int2> _VoxelTraceRayCompactBuffer;

[numthreads(64, 1, 1)]
void InitialSampleVoxelTrace(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    ClipmapInfo clipmapInfo = ResolveClipmapInfo();

    int rayCount = _VoxelTraceRayCounter[0];
    if (threadId.x >= rayCount)
    {
        return;
    }

    // 1. rebuild tracing context
    int2 pixelCoord = _VoxelTraceRayCompactBuffer[threadId.x];
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_ScreenGatherRTSize);
    PixelContext pixelCtx = ResolvePixelContext(uv);
    
    // we start from screen trace's ray end
    float3 voxelCellSize = GetVoxelCellSize(clipmapInfo, pixelCtx.worldPosition);
    float screenTraceRayDistance = clamp(_RWInitialSampleHitInfo[pixelCoord].w, voxelCellSize * 0.1, voxelCellSize * 3);
    float3 rayStart = pixelCtx.worldPosition + pixelCtx.rayDirection * screenTraceRayDistance;
    
    // prevent self intersection at graze angle
    float NoL = saturate(dot(pixelCtx.worldNormal, pixelCtx.rayDirection));
    float3 normalOffset = pixelCtx.worldNormal * voxelCellSize * lerp(1, 0.05, NoL);
    rayStart += normalOffset;

    // 2. trace ray
    VoxelRaytracingRequest RTRequest = (VoxelRaytracingRequest) 0;
    RTRequest.rayStart = rayStart;
    RTRequest.rayDir = pixelCtx.rayDirection;
    RTRequest.minCascadeIndex = 0;
    RTRequest.maxCascadeIndex = clipmapInfo.cascadeCount - 1;
    RTRequest.maxStepNum = 114514;
    RTRequest.maxDistance = 191981000;

#if USE_DISTANCE_FIELD
    VoxelRayTracingHitPayload hit = DistanceFieldRaytracing(clipmapInfo, _DistanceFieldClipmap, sampler_linearClamp, RTRequest);
#else
    VoxelRayTracingHitPayload hit = VoxelRaytracing(clipmapInfo, _VoxelBitOccupyClipmap, RTRequest);
#endif

    // 3. handle ray hit
    float3 hitRadiance = float3(0, 0, 0);
    float3 hitNormal = float3(0, 0, 0);
    float rayDistance = 0;
    if (hit.isHit)
    {
        hitRadiance = FetchRadianceFromVoxelScene(RTRequest, hit);
        rayDistance = length(hit.position - pixelCtx.worldPosition);
        hitNormal = FetchRadianceFromVoxelScene(RTRequest, hit);
    }
    else
    {
        rayDistance = 191981000;
        hitRadiance = float3(1, 1, 1);
        hitNormal = pixelCtx.rayDirection * -1;
    }

    _RWInitialSampleRadiance[pixelCoord] = float4(hitRadiance, hit.isHit);
    _RWInitialSampleHitInfo[pixelCoord] = float4(hitNormal * 0.5 + 0.5, rayDistance);
}

// -------------------------------------------------------------------------------- //
#pragma kernel ReservoirTemporalReuse

Texture2D<float4> _InitialSampleRadiance;
Texture2D<float4> _InitialSampleHitInfo;

Texture2D<float4> _ReservoirDataA;
Texture2D<float4> _ReservoirDataB;
Texture2D<float4> _ReservoirDataC;
Texture2D<float4> _ReservoirDataD;

RWTexture2D<float4> _RWReservoirDataA;
RWTexture2D<float4> _RWReservoirDataB;
RWTexture2D<float4> _RWReservoirDataC;
RWTexture2D<float4> _RWReservoirDataD;

Reservoir FetchReservoir(float2 uv)
{
    float4 rawData[4];
    rawData[0] = _ReservoirDataA.SampleLevel(sampler_PointClamp, uv, 0);
    rawData[1] = _ReservoirDataB.SampleLevel(sampler_PointClamp, uv, 0);
    rawData[2] = _ReservoirDataC.SampleLevel(sampler_PointClamp, uv, 0);
    rawData[3] = _ReservoirDataD.SampleLevel(sampler_PointClamp, uv, 0);
    return DecodeReservoirData(rawData);
}

bool IsUVOutSideScreen(float2 uv)
{
    // note: physical texture size may different with viewport size due to UE editor
    // so max uv boundary decided by ScreenPositionScaleBias, not const 1.0
    //float2 ViewportUV = BufferUVToViewportUV(uv);
    float2 ViewportUV = uv;
    return any(ViewportUV <= -0.01) || any(ViewportUV > 1.01);
}

[numthreads(8, 8, 1)]
void ReservoirTemporalReuse(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    // 1. do some setup
    const int2 pixelCoord = clamp(threadId.xy, 0, _ScreenGatherRTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_ScreenGatherRTSize);
    PixelContext pixelCtx = ResolvePixelContext(uv);
    
    if (any(threadId.xy >= _ScreenGatherRTSize) || pixelCtx.rawDepth <= 0)
    {
        _RWReservoirDataA[pixelCoord] = float4(0, 0, 0, 0);
        _RWReservoirDataB[pixelCoord] = float4(0, 0, 0, 0);
        _RWReservoirDataC[pixelCoord] = float4(0, 0, 0, 0);
        _RWReservoirDataD[pixelCoord] = float4(0, 0, 0, 0);
        return;
    }

    // 2. setup reservoir sample for current frame's new sample
    ReservoirSample newSample = (ReservoirSample) 0;
    newSample.radiance = _InitialSampleRadiance.SampleLevel(sampler_PointClamp, uv, 0).rgb;
    newSample.rayStart = pixelCtx.worldPosition;
    newSample.rayStartNormal = pixelCtx.worldNormal;

    float4 hitInfo = _InitialSampleHitInfo.SampleLevel(sampler_PointClamp, uv, 0); // hit normal (xyz) and distance (w)
    newSample.rayEnd = pixelCtx.worldPosition + pixelCtx.rayDirection.xyz * hitInfo.w;
    newSample.rayEndNormal = hitInfo.xyz * 2 - 1;

    // 3. reproject and search 3x3 to find match pixel
    float2 reprojectCenterUV = ReprojectPixel(float3(uv, pixelCtx.rawDepth));
    int2 reprojectCenterCoord = reprojectCenterUV * _ScreenGatherRTSize;

    float minDistance = 11451419.19;
    float2 reprojectUV = reprojectCenterUV;
    int reprojectValidCount = 0;
    for (int i = 0; i < 9; i++)
    {
        int2 neighborPixelCoord = reprojectCenterCoord + offsets3x3[i];
        float2 neighborUV = (float2(neighborPixelCoord) + 0.5) / float2(_ScreenGatherRTSize);
        reprojectValidCount += IsUVOutSideScreen(neighborUV) ? 0 : 1;
        
        // calculate distance between reservoir and current pixel
        float3 neighborPosition = _ReservoirDataC.SampleLevel(sampler_PointClamp, neighborUV, 0).xyz; // see DecodeReservoirData()
        float distance = length(pixelCtx.worldPosition - neighborPosition);

        if (distance < minDistance)
        {
            minDistance = distance;
            reprojectUV = neighborUV;
        }
    }

    // 4. fetch temporal reservoir
    Reservoir temporalReservoir = FetchReservoir(reprojectUV);

    // calculate geometry similarity to decide if we need cleanup reservoir history
    float distance = length(pixelCtx.worldPosition - temporalReservoir.currentSample.rayStart);
    float normalDot = abs(dot(pixelCtx.worldNormal, temporalReservoir.currentSample.rayStartNormal));
    if (distance > 0.5 || reprojectValidCount == 0 || isnan(temporalReservoir.weightSum) || isnan(temporalReservoir.estimatorWeight))
    {
        temporalReservoir = (Reservoir) 0;
    }

    // 5. do temporal reuse
    float targetPDF = EvaluateTargetPDF(newSample, newSample.rayStart, newSample.rayStartNormal);
    float sourcePDF = pixelCtx.rayDirection.w;
    float selectionWeight = targetPDF / sourcePDF;
    
    UpdateReservoir(temporalReservoir, newSample, selectionWeight, pixelCtx.randomVector.w);
    
    ClampSampleNumAndUpdateEstimatorWeight(temporalReservoir, pixelCtx.worldPosition, pixelCtx.worldNormal, 5);

    // 6. write reservoir back to buffer
    float4 reservoirRawData[4];
    EncodeReservoirData(temporalReservoir, reservoirRawData);

    _RWReservoirDataA[pixelCoord] = reservoirRawData[0];
    _RWReservoirDataB[pixelCoord] = reservoirRawData[1];
    _RWReservoirDataC[pixelCoord] = reservoirRawData[2];
    _RWReservoirDataD[pixelCoord] = reservoirRawData[3];
}

// -------------------------------------------------------------------------------- //
#pragma kernel ReservoirSpatialReuse

int _SpatialReuseSampleCount;
float _SpatialReuseSearchRange;

[numthreads(8, 8, 1)]
void ReservoirSpatialReuse(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    // 1. fetch reservoir
    const float2 screenGatherTexelSize = 1.0 / float2(_ScreenGatherRTSize);
    const int2 pixelCoord = threadId.xy;
    const float2 uv = (float2(pixelCoord) + 0.5) * screenGatherTexelSize;
    uint2 randomSeed1 = Rand3DPCG16(uint3(uv * 11451.514, _FrameNumber + 1919)).xy;
    uint2 randomSeed2 = Rand3DPCG16(uint3(uv * 1234.567, _FrameNumber + 89)).xy;
    
    PixelContext pixelCtx = ResolvePixelContext(uv);
    Reservoir reservoir = FetchReservoir(uv);

    if (any(threadId.xy >= _ScreenGatherRTSize) || pixelCtx.rawDepth <= 0)
    {
        _RWReservoirDataA[pixelCoord] = float4(0, 0, 0, 0);
        _RWReservoirDataB[pixelCoord] = float4(0, 0, 0, 0);
        _RWReservoirDataC[pixelCoord] = float4(0, 0, 0, 0);
        _RWReservoirDataD[pixelCoord] = float4(0, 0, 0, 0);
        return;
    }

    // 2. calculate spatial search range
    // use cur pixel's depth to keep range constant in world space
    float3 worldPositionDDXY = ReconstructWorldPositionFromDepth(uv + screenGatherTexelSize, pixelCtx.rawDepth);
    float3 vectorDDXY = length(pixelCtx.worldPosition - worldPositionDDXY);
    float distanceDDXY = max(max(vectorDDXY.x, vectorDDXY.y), vectorDDXY.z);
    float uvSearchRange = clamp((_SpatialReuseSearchRange / distanceDDXY) * screenGatherTexelSize, 0.02, 0.2);

    // 3. reuse neighbor reservoirs
    for (int i = 0; i < _SpatialReuseSampleCount; i++)
    {
        float2 E1 = Hammersley16(i, _SpatialReuseSampleCount, randomSeed1);
        float2 E2 = Hammersley16(i, _SpatialReuseSampleCount, randomSeed2);
        
        // 3.1. fetch neighbor
        float2 uvOffset = UniformSampleDisk(E1);
        float2 neighborUV = uv + uvOffset * uvSearchRange;
        if (IsUVOutSideScreen(neighborUV))
        {
            continue;
        }

        Reservoir neighborReservoir = FetchReservoir(neighborUV);

        // 3.2. consider geometry similarity
        float3 neighborPixelPosition, neighborPixelNormal;
        GetPixelPositionAndNormal(neighborUV, neighborPixelPosition, neighborPixelNormal);
        
        float3 reusedPath = neighborReservoir.currentSample.rayEnd - pixelCtx.worldPosition;
        float3 neighborPath = neighborReservoir.currentSample.rayEnd - neighborReservoir.currentSample.rayStart;

        float hemisphereDot1 = dot(pixelCtx.worldNormal, reusedPath);
        float hemisphereDot2 = dot(pixelCtx.worldNormal, neighborPath);
        float hemisphereDot3 = dot(neighborReservoir.currentSample.rayStartNormal, neighborPath);
        float normalDot = dot(pixelCtx.worldNormal, neighborPixelNormal);
        if (hemisphereDot1 <= 0 || hemisphereDot2 <= 0 || hemisphereDot3 <= 0 || normalDot < 0.8)
        {
            continue;
        }

        // 3.3. calculate jacobian to scale solid angle (measurement density)
        float neighborPathCosine = dot(normalize(-neighborPath), neighborReservoir.currentSample.rayEndNormal);
        float reusedPathCosine = dot(normalize(-reusedPath), neighborReservoir.currentSample.rayEndNormal);
        float jacobian = (neighborPathCosine * LengthSquare(reusedPath)) / (reusedPathCosine * LengthSquare(neighborPath));

        if (neighborPathCosine <= 0 || reusedPathCosine <= 0)
        {
            continue;
        }

        // 3.4. see other reservoir as one sample, calculate merge weight
        // evaluate neighbor sample's target pdf with current pixel's position and normal
        float targetPDF = EvaluateTargetPDF(neighborReservoir.currentSample, pixelCtx.worldPosition, pixelCtx.worldNormal);
        targetPDF /= clamp(jacobian, 0.1, 10); // clamp to prevent firefly
        float mergeWeight = targetPDF * neighborReservoir.estimatorWeight * neighborReservoir.sampleCount; // p_hat * W * M in paper

        // 3.5. merge reservoir
        // note: UpdateReservoir() will add 1 to NumSamples, but we dont need it, just record origin value here
        int sampleCountOld = reservoir.sampleCount;
        UpdateReservoir(reservoir, neighborReservoir.currentSample, mergeWeight, E2.x);
        
        // accumulate sample num, we repeatedly check neighbor sample N times
        reservoir.sampleCount = sampleCountOld + neighborReservoir.sampleCount;
        
        ClampSampleNumAndUpdateEstimatorWeight(reservoir, pixelCtx.worldPosition, pixelCtx.worldNormal, 1024);
    }

    // 4. write reservoir back to buffer
    float4 reservoirRawData[4];
    EncodeReservoirData(reservoir, reservoirRawData);

    _RWReservoirDataA[pixelCoord] = reservoirRawData[0];
    _RWReservoirDataB[pixelCoord] = reservoirRawData[1];
    _RWReservoirDataC[pixelCoord] = reservoirRawData[2];
    _RWReservoirDataD[pixelCoord] = reservoirRawData[3];
}

// -------------------------------------------------------------------------------- //
#pragma kernel ReservoirEvaluateIrradiance

#ifndef INDIRECT_SHADOW_ENABLE
#define INDIRECT_SHADOW_ENABLE 0
#endif

Texture2D _IrradianceFallbackTexture;
RWTexture2D<float4> _RWReservoirIrradiance;
RWTexture2D<float4> _RWIndirectShadowTexture;

[numthreads(8, 8, 1)]
void ReservoirEvaluateIrradiance(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    // 1. fetch reservoir
    const int2 pixelCoord = clamp(threadId.xy, 0, _ScreenGatherRTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_ScreenGatherRTSize);

    PixelContext pixelCtx = ResolvePixelContext(uv);
    Reservoir reservoir = FetchReservoir(uv);
    
    if (any(threadId.xy >= _ScreenGatherRTSize) || pixelCtx.rawDepth <= 0)
    {
        _RWReservoirIrradiance[pixelCoord] = float4(0, 0, 0, 0);
        return;
    }

    // 2. do RIS estimate
    float3 radiance = reservoir.currentSample.radiance * reservoir.estimatorWeight;
    float3 rayDir = normalize(reservoir.currentSample.rayEnd - pixelCtx.worldPosition);
    float cosTheta = max(dot(rayDir, pixelCtx.worldNormal), 0.0); // clamp to prevent black hole pixel, see EvaluateTargetPDF()

    float3 irradiance = radiance * cosTheta / PI;
    _RWReservoirIrradiance[pixelCoord] = float4(irradiance, 1);
    
    // 3. test visibility for spatial reservoir sample
#if INDIRECT_SHADOW_ENABLE
    uint2 randomSeed = Rand3DPCG16(uint3(uv * 6567, _FrameNumber + 77)).xy;
    float2 E = Hammersley16(0, 1, randomSeed);
    float3 rayOriginTranslatedWorld = pixelCtx.worldPosition - _CameraPosition;

    float3 hitUVz = float3(0, 0, 0);
    float hitLevel = 0;
    bool isHit = RayCast(
        _HZB, sampler_PointClamp,
        rayOriginTranslatedWorld, rayDir,
        0.05, // roughness 
        pixelCtx.sceneDepth,
        32, // NumSteps
        E.x, // SSRStepOffset
        _HZBUvFactorAndInvFactor, 
        false, // debug print
        _TranslatedWorldToClip, _ProjMat,
        _ScreenPositionScaleBias,
        hitUVz, hitLevel
    );

    // if spatial reservoir's sample are invisible for current pixel, we fallback to temporal reservoir
    float3 testRayEndPosition = ReconstructWorldPositionFromDepth(hitUVz.xy, hitUVz.z);
    float testRayDistance = length(testRayEndPosition - pixelCtx.worldPosition);
    float reservoirRayDistance = length(reservoir.currentSample.rayEnd - pixelCtx.worldPosition);
    float reservoirConfidence = isHit ? saturate(testRayDistance / reservoirRayDistance) : 1;

    // lerp irradiance based on confidence
    float3 irradianceFallback = _IrradianceFallbackTexture.SampleLevel(sampler_linearClamp, uv, 0).rgb;
    _RWReservoirIrradiance[pixelCoord] = float4(lerp(irradianceFallback, irradiance, reservoirConfidence), 1);

    // output confidence as indirect shadow
    _RWIndirectShadowTexture[pixelCoord] = reservoirConfidence;
#else
    _RWIndirectShadowTexture[pixelCoord] = 1;
#endif  // INDIRECT_SHADOW_ENABLE
}

// ---------------------------------------- (^^_) ---------------------------------------- //
#pragma kernel FilterGuidanceSSAO

float _AOWorldRange;
float _AOSharpness;

RWTexture2D<float4> _RWDiffuseResolveOutputTexture;

float3 TransformPositionWorldToView(float3 worldPosition)
{
    float3 translatedWorldPosition = worldPosition - _CameraPosition;
    float3 viewSpacePosition = mul(_TranslatedWorldToView, float4(translatedWorldPosition, 1));
    return viewSpacePosition;
}

float3 TransformDirectionWorldToView(float3 worldNormal)
{
    return normalize(mul((half3x3) _TranslatedWorldToView, worldNormal));
}

[numthreads(8, 8, 1)]
void FilterGuidanceSSAO(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    float2 screenGatherTexelSize = rcp(float2(_ScreenGatherRTSize));
    const int2 pixelCoord = clamp(threadId.xy, 0, _ScreenGatherRTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_ScreenGatherRTSize);
    if (any(threadId.xy >= _ScreenGatherRTSize))
    {
        return;
    }
    
    uint2 randomSeed = Rand3DPCG16(uint3(uv * 333, _FrameNumber + 444)).xy;
    PixelContext pixelCtx = ResolvePixelContext(uv);
    float3 viewDirection = normalize(_CameraPosition - pixelCtx.worldPosition);
    float3 viewSpacePosition = TransformPositionWorldToView(pixelCtx.worldPosition);
    float3 viewSpaceNormal = TransformDirectionWorldToView(pixelCtx.worldNormal);

    float3 worldPositionDDXY = ReconstructWorldPositionFromDepth(uv + screenGatherTexelSize, pixelCtx.rawDepth);
    float3 DDXY = length(pixelCtx.worldPosition - worldPositionDDXY);
    float distanceDDXY = max(max(DDXY.x, DDXY.y), DDXY.z);
    float uvSearchRange = clamp((_AOWorldRange / distanceDDXY) * screenGatherTexelSize, 0.005, 0.5);

    const int directionCount = 4;
    const int stepCount = 4;
    float uvSearchStep = uvSearchRange / float(stepCount);

    float2 E = Hammersley16(0, 1, randomSeed);
    float randomStepOffset = E.x;
    float rotateAngle = E.y * PI * 2;
    
    float AOSum = 0;
    float weightSum = 0;
    float3 samplePosition, sampleNormal;
    for (int i = 0; i < directionCount; i++)
    {
        float2 direction2D = float2(cos(rotateAngle), sin(rotateAngle));

        float bestOcclusion = 0;
        for (int j = 0; j < stepCount; j++)
        {
            float2 sampleUV = uv + direction2D * uvSearchStep * (float(j) + randomStepOffset);
            float sampleDepth = GetPixelPositionAndNormal(sampleUV, samplePosition, sampleNormal);

            // calculate occlusion for current sample
            float3 viewSpaceSample = mul(_ViewMat, float4(samplePosition, 1));
            float3 pixelToSample = viewSpaceSample - viewSpacePosition;
            float distance = length(pixelToSample);
            float occlusion = dot(viewSpaceNormal, pixelToSample) / distance;

            // calculate max horizontal occlusion
            float delta = max(occlusion - bestOcclusion, 0);
            bestOcclusion = max(bestOcclusion, occlusion);

            // lerp occlusion based on distance
            float fallOffWeight = saturate(1 - (distance * distance) / (_AOWorldRange * _AOWorldRange));
            float AO = delta * fallOffWeight;

            AOSum += AO;
            weightSum += fallOffWeight;
        }
        
        rotateAngle += 2 * PI / float(directionCount);
    }
    
    float finalOcclusion = AOSum / weightSum;
    finalOcclusion = saturate(1 - finalOcclusion);
    finalOcclusion = pow(finalOcclusion, _AOSharpness);
    
    _RWDiffuseResolveOutputTexture[pixelCoord] = float4(finalOcclusion.xxxx);
}

// -------------------------------------------------------------------------------- //
#pragma kernel DiffuseTemporalFilter

float _TemporalFilterWeight;
float _HistoryColorBoundScale;

Texture2D<float4> _DiffuseIndirectTexture;
Texture2D<float4> _DiffuseIndirectHistory;
Texture2D<float4> _IndirectShadowTexture;
Texture2D<float4> _IndirectShadowHistory;
RWTexture2D<float4> _RWDiffuseTemporalFilterOutput;
RWTexture2D<float4> _RWIndirectShadowTemporalFilterOutput;

float3 ClampHistory(in float4 colorSamples[9], float3 currentColor, float3 historyColor, float colorBoundScale)
{
    currentColor = RGBToYCoCg(currentColor);
    historyColor = RGBToYCoCg(historyColor);

    // 1. calculate history color bounding box
    float3 neighborMin = 1000;
    float3 neighborMax = -1000;
    for (int i = 0; i < 9; i++)
    {
        float3 colorYCoCg = RGBToYCoCg(colorSamples[i].rgb);
        neighborMin = min(neighborMin, colorYCoCg);
        neighborMax = max(neighborMax, colorYCoCg);
    }
    
    // extend the color bounding box to avoid file flies, but may cause temporal lag
    float3 neighborCenter = (neighborMax + neighborMin) * 0.5;
    neighborMin += (neighborMin - neighborCenter) * colorBoundScale;
    neighborMax += (neighborMax - neighborCenter) * colorBoundScale;

    // 2. find intersection from history color to current color bounding box
    float3 rayOrigin = historyColor;
    float3 rayDir = currentColor - historyColor;
    rayDir = abs(rayDir) < (1.0 / 65536.0) ? (1.0 / 65536.0) : rayDir;
    float3 invRayDir = rcp(rayDir);

    float3 minIntersect = (neighborMin - rayOrigin) * invRayDir;
    float3 maxIntersect = (neighborMax - rayOrigin) * invRayDir;
    float3 enterIntersect = min(minIntersect, maxIntersect);

    // 3. clamp history color to boundary of current color bounding box
    float clipBlend = saturate(max(max(enterIntersect.x, enterIntersect.y), enterIntersect.z));
    float3 resultYCoCg = lerp(historyColor, currentColor, clipBlend);
    return YCoCgToRGB(resultYCoCg);
}

[numthreads(8, 8, 1)]
void DiffuseTemporalFilter(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    // 1. setup
    const float2 screenGatherTexelSize = 1.0 / float2(_ScreenGatherRTSize);
    const int2 pixelCoord = clamp(threadId.xy, 0, _ScreenGatherRTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_ScreenGatherRTSize);
    PixelContext pixelCtx = ResolvePixelContext(uv);

    if (any(threadId.xy >= _ScreenGatherRTSize) || IsUVOutSideScreen(uv) || pixelCtx.rawDepth <= 0)
    {
        _RWDiffuseTemporalFilterOutput[pixelCoord] = float4(0, 0, 0, 0);
        return;
    }

    float4 colorSamples[9];
    float4 shadowSamples[9];
    for (int i = 0; i < 9; i++)
    {
        float2 neighborUV = uv + offsets3x3[i] * screenGatherTexelSize;
        colorSamples[i] = _DiffuseIndirectTexture.SampleLevel(sampler_PointClamp, neighborUV, 0);
        shadowSamples[i] = _IndirectShadowTexture.SampleLevel(sampler_PointClamp, neighborUV, 0).r;
    }
    float4 currentColor = colorSamples[0];

    // 2. fetch history
    float2 reprojectUV = ReprojectPixel(float3(uv, pixelCtx.rawDepth));
    float4 historyColor = _DiffuseIndirectHistory.SampleLevel(sampler_linearClamp, reprojectUV, 0);
    historyColor = ClampNaNs(historyColor);

    // 3. reject history if geometry change
    float4 historyNormalDepth = _NormalDepthHistory.SampleLevel(sampler_PointClamp, reprojectUV, 0);
    float3 historyNormal = historyNormalDepth.xyz * 2 - 1;
    float historySceneDepth = ConvertFromDeviceZ(historyNormalDepth.w);

    float historyWeight = _TemporalFilterWeight;
    float AOHistoryWeight = 0.8;
    float shadowHistoryWeight = 0.9;
    if (IsUVOutSideScreen(reprojectUV) || dot(historyNormal, pixelCtx.worldNormal) < 0.5 || abs(pixelCtx.sceneDepth - historySceneDepth) > 0.5)
    {
        historyWeight = 0;
        AOHistoryWeight = 0;
        shadowHistoryWeight = 0;
    }
    
    // 4. clamp history
    historyColor.rgb = ClampHistory(colorSamples, currentColor.rgb, historyColor.rgb, _HistoryColorBoundScale);
    float4 outColor = float4(0, 0, 0, 0);
    outColor.rgb = lerp(currentColor.rgb, historyColor.rgb, historyWeight);
    
    // 5. output filter guidance ssao
    float AOSum = 0;
    for (int i = 0; i < 9; i++)
    {
        AOSum += colorSamples[i].a;
    }
    outColor.a = lerp(AOSum / 9.0, historyColor.a, AOHistoryWeight);
    _RWDiffuseTemporalFilterOutput[pixelCoord] = outColor;
    
    // 6. output indirect shadow
    float shadowHistory = _IndirectShadowHistory.SampleLevel(sampler_linearClamp, reprojectUV, 0).r;
    float shadowSum = 0;
    for (int i = 0; i < 9; i++)
    {
        shadowSum += shadowSamples[i];
    }
    _RWIndirectShadowTemporalFilterOutput[pixelCoord] = lerp(shadowSum / 9.0, shadowHistory, shadowHistoryWeight);
}

// -------------------------------------------------------------------------------- //
#pragma kernel DiffuseSpatialFilter

#define ATROUS_SAFE_RANGE (4.0)

int2 _RTSize;
float _FilterRadius;
float _SSAOGuidanceWeight;

RWTexture2D<float4> _RWSpatialFilterOutput;
#if INDIRECT_SHADOW_ENABLE
RWTexture2D<float4> _RWShadowOutput;
#endif

[numthreads(8, 8, 1)]
void DiffuseSpatialFilter(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    // 1. setup
    const float2 texelSize = 1.0 / float2(_RTSize);
    const int2 pixelCoord = clamp(threadId.xy, 0, _RTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_RTSize);
    uint2 randomSeed = Rand3DPCG16(uint3(uv * 11451.514, _FrameNumber + 1919)).xy;
    PixelContext pixelCtx = ResolvePixelContext(uv);

    if (any(threadId.xy >= _RTSize) || IsUVOutSideScreen(uv) || pixelCtx.rawDepth <= 0)
    {
        _RWSpatialFilterOutput[pixelCoord] = float4(0, 0, 0, 0);
        return;
    }

    // 2. filter current frame output
    float4 centerColor = _DiffuseIndirectTexture.SampleLevel(sampler_linearClamp, uv, 0);
    float guidanceSSAO = centerColor.w;
    float weightSum = gaussianWeights3x3[0];
    float4 colorSum = centerColor * gaussianWeights3x3[0];
    
#if INDIRECT_SHADOW_ENABLE
    float shadowSum = _IndirectShadowTexture.SampleLevel(sampler_linearClamp, uv, 0).r * gaussianWeights3x3[0];
#endif
    
    for (int i = 1; i < 9; i++)
    {
        float2 E = Hammersley16(i - 1, 9 - 1, randomSeed) * 2 - 1;
        float2 uvJitter = (_FilterRadius > ATROUS_SAFE_RANGE) ? E * 0.25 : 0;
        float2 neighborUV = uv + (offsets3x3[i] + uvJitter) * _FilterRadius * texelSize;
        if (IsUVOutSideScreen(neighborUV))
        {
            continue;
        }

        float4 neighborColor = _DiffuseIndirectTexture.SampleLevel(sampler_linearClamp, neighborUV, 0);
        neighborColor = ClampNaNs(neighborColor);

        float3 neighborPixelPosition, neighborPixelNormal;
        float neighborDepth = GetPixelPositionAndNormal(neighborUV, neighborPixelPosition, neighborPixelNormal);

        float weight = 1;
        weight *= gaussianWeights3x3[i];
        weight *= exp(-abs(neighborDepth - pixelCtx.sceneDepth) * 0.01);
        weight *= saturate(dot(neighborPixelNormal, pixelCtx.worldNormal));
        weight *= exp(-abs(guidanceSSAO - neighborColor.w) * _SSAOGuidanceWeight);

        colorSum += neighborColor * weight;
        weightSum += weight;
        
#if INDIRECT_SHADOW_ENABLE
        float neighborShadow = _IndirectShadowTexture.SampleLevel(sampler_linearClamp, neighborUV, 0).r;
        shadowSum += neighborShadow * weight;
#endif
    }
    
    float3 color = (weightSum > 0) ? (colorSum.rgb / weightSum) : 0;
    _RWSpatialFilterOutput[pixelCoord] = float4(color, guidanceSSAO);
    // _RWSpatialFilterOutput1[pixelCoord] = (weightSum > 0) ? (colorSum / weightSum) : 0;
    
#if INDIRECT_SHADOW_ENABLE
    _RWShadowOutput[pixelCoord] = (weightSum > 0) ? (shadowSum / weightSum) : 1;
#endif
}

// -------------------------------------------------------------------------------- //
#pragma kernel DiffuseComposite

float _AOIntensity;
Texture2D<float4> _GBufferBaseColor;
RWTexture2D<float4> _RWDiffuseCompositeTexture;

[numthreads(8, 8, 1)]
void DiffuseComposite(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    float2 screenGatherTexelSize = rcp(float2(_ScreenGatherRTSize));
    const int2 pixelCoord = clamp(threadId.xy, 0, _SceneTextureRTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_SceneTextureRTSize);
    uint2 randomSeed = Rand3DPCG16(uint3(uv * 11451.514, _FrameNumber + 1919)).xy;
    if (any(threadId.xy >= _SceneTextureRTSize))
    {
        return;
    }
    
    float3 worldNormal = _GBufferNormal.SampleLevel(sampler_linearClamp, uv, 0).rgb;
    
    float shadowSum = 0;
    float4 colorSum = 0;
    float weightSum = 0;
    const int sampleCount = 4;
    const float searchRange = 2.0;
    for (int i = 0; i < sampleCount; i++)
    {
        float2 uvOffset = Hammersley16(i, sampleCount, randomSeed) * 2 - 1;
        float2 neighborUV = uv + uvOffset * screenGatherTexelSize * searchRange;

        float shadow = _IndirectShadowTexture.SampleLevel(sampler_PointClamp, uv, 0).r;
        float4 color = _DiffuseIndirectTexture.SampleLevel(sampler_PointClamp, neighborUV, 0);
        float4 normalDepth = _NormalDepthTexture.SampleLevel(sampler_PointClamp, neighborUV, 0);
        float3 neighborNormal = normalDepth.xyz * 2 - 1;
        float neighborDepth = ConvertFromDeviceZ(normalDepth.a);

        float weight = 1.0;
        weight *= exp(-abs(neighborDepth - ConvertFromDeviceZ(_SceneDepthTexture.SampleLevel(sampler_PointClamp, uv, 0))));
        weight *= saturate(dot(neighborNormal, worldNormal));

        colorSum += color * weight;
        shadowSum += shadow * weight;
        weightSum += weight;
    }
    float4 filterColor = colorSum / weightSum;
    float indirectShadow = shadowSum / weightSum;

    // apply diffuse lighting
    float metallic = 0;
    float3 diffuseIndirect = filterColor.rgb;
    diffuseIndirect *= _GBufferBaseColor.SampleLevel(sampler_PointClamp, uv, 0) * (1.0 - metallic); // @TODO: consider shading models

    // apply AO and indirect shadow, not physically based here, just a trick
    float AO = filterColor.a;
    AO = lerp(1, AO, _AOIntensity);
    AO = min(AO, indirectShadow);
    diffuseIndirect *= AO;

    _RWDiffuseCompositeTexture[threadId.xy] = float4(ClampNaNs(diffuseIndirect), 1);
    // _RWDiffuseCompositeTexture[threadId.xy] = _DiffuseIndirectTexture.SampleLevel(sampler_linearClamp, uv, 0).wwww;   // debug ssao
    // _RWDiffuseCompositeTexture[threadId.xy] = IndirectShadow;   // debug indirect shadow
}

// -------------------------------------------------------------------------------- //
#pragma kernel SpecularResolve

#define SIMPLIFY_RESOLVE_BRDF 1
#define APPLY_BRDF_AFTER_TAA 1
#define RADIANCE_TONEMAPPING 1

float _SpecularResolveSearchRange;

Texture2D<float4> _GBufferSpecular;
RWTexture2D<float4> _RWSpecularResolveOutputTexture;

// https://www.ea.com/frostbite/news/stochastic-screen-space-reflections
float3 EvaluateRatioEstimatorBRDF(float3 curPixelWorldPosition, in float4 normalRoughness, in float3 specularColor, float3 rayHitPosition, float rayPDF)
{
    // reconnect neighbor ray's hit point with current pixel 
    float3 L = normalize(rayHitPosition - curPixelWorldPosition);
    float3 V = normalize(_CameraPosition - curPixelWorldPosition);
    float3 H = normalize(V + L);
    float3 N = normalRoughness.xyz;

    float3 NoH = clamp(1e-3, dot(N, H), 1);
    float3 NoV = clamp(1e-3, dot(N, V), 1);
    float3 NoL = clamp(1e-3, dot(N, L), 1);
    float3 VoH = clamp(1e-3, dot(V, H), 1);

    // calculate BRDF for reconnect ray
    float a2 = Pow4(normalRoughness.w);
    float D = D_GGX(a2, NoH);
    float Vis = Vis_SmithJointApprox(a2, NoV, NoL);
    float3 F = F_Schlick(specularColor, VoH);

#if SIMPLIFY_RESOLVE_BRDF
    float3 BRDF = D * Vis * F;
#else
    float3 BRDF = D;
#endif

    return (rayPDF > 0) ? (BRDF * NoL / rayPDF) : 0;
}

[numthreads(8, 8, 1)]
void SpecularResolve(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    // 1. setup
    const float2 screenGatherTexelSize = 1.0 / float2(_ScreenGatherRTSize);
    const int2 pixelCoord = clamp(threadId.xy, 0, _SceneTextureRTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_SceneTextureRTSize);
    if (any(threadId.xy >= _SceneTextureRTSize))
    {
        return;
    }
    uint2 randomSeed = Rand3DPCG16(uint3(uv * 11451.514, _FrameNumber + 1919)).xy;
    
    float4 GBufferNormalRoughness = _GBufferNormal.SampleLevel(sampler_PointClamp, uv, 0);
    float3 GBufferSpecular = _GBufferSpecular.SampleLevel(sampler_PointClamp, uv, 0);
    
    // bug ??
    float3 worldPosition = ReconstructWorldPositionFromDepth(uv, _SceneDepthTexture.SampleLevel(sampler_PointClamp, uv, 0));

    // 2. query and resolve neighbor pixels
    const int resolveSampleCount = 4;
    float3 radianceSum = 0;
    float3 weightSum = 0;
    float rayDistanceSum = 0;
    for (int i = 0; i < resolveSampleCount; i++)
    {
        // 2.1. randomly pick a neighbor pixel in half resolution ray buffer
        float2 E = Hammersley16(i, resolveSampleCount, randomSeed);
        // float2 UVOffset = UniformSampleDisk(E);
        float2 uvOffset = E * 2 - 1;
        float2 neighborUV = uv + uvOffset * screenGatherTexelSize * _SpecularResolveSearchRange;
        PixelContext neighborPixelCtx = ResolvePixelContext(neighborUV);

        float3 hitRadiance = _InitialSampleRadiance.SampleLevel(sampler_PointClamp, neighborUV, 0).rgb;
        float rayDistance = _InitialSampleHitInfo.SampleLevel(sampler_PointClamp, neighborUV, 0).w;
        
        float3 rayStartPosition = neighborPixelCtx.worldPosition;
        float3 rayHitPosition = rayStartPosition + neighborPixelCtx.rayDirection.xyz * rayDistance;
        float rayPDF = neighborPixelCtx.rayDirection.w;

        // 2.2. calculate local BRDF for reused ray and apply ratio estimator
        float3 weight = EvaluateRatioEstimatorBRDF(worldPosition, GBufferNormalRoughness, GBufferSpecular, rayHitPosition, rayPDF);
        weight *= exp(length(rayStartPosition - worldPosition) * -0.01);

#if RADIANCE_TONEMAPPING
        hitRadiance = hitRadiance / (1.0 + Luma(hitRadiance));
#endif

        radianceSum += hitRadiance * weight;
        weightSum += weight;
        rayDistanceSum += rayDistance;
    }
    float3 resolveRadiance = radianceSum / weightSum;
    float rayAverageDistance = rayDistanceSum / float(resolveSampleCount);

#if RADIANCE_TONEMAPPING
    resolveRadiance = resolveRadiance / (1.0 - Luma(resolveRadiance));
#endif
    
    // 3. evaluate full specular integral
#if !APPLY_BRDF_AFTER_TAA
    float3 V = normalize(_CameraPosition - worldPosition);
    float NoV = saturate(dot(GBufferNormalRoughness.xyz, V));
    float3 preIntegratedGF = EnvBRDF(GBufferSpecular, GBufferNormalRoughness.w, NoV);
    float3 specularIndirect = resolveRadiance * preIntegratedGF;
#else
    float3 specularIndirect = resolveRadiance;
#endif

    _RWSpecularResolveOutputTexture[pixelCoord] = float4(specularIndirect, rayAverageDistance);
}

// -------------------------------------------------------------------------------- //
#pragma kernel SpecularTemporalFilter

Texture2D<float4> _SpecularIndirectTexture;
Texture2D<float4> _SpecularIndirectHistory;

RWTexture2D<float4> _RWSpecularTemporalFilterOutput;

float4 SpecularIndirectFetchHistory(float3 worldPosition, float2 currentUV)
{
    // reproject pixel
    float3 currentFrameUVz = WorldToScreen(worldPosition);
    float2 reprojectUV = ReprojectPixel(currentFrameUVz);

    // fetch history
    float3 historyColor = _SpecularIndirectHistory.SampleLevel(sampler_linearClamp, reprojectUV, 0).rgb;
    historyColor = ClampNaNs(historyColor);

    // reject history if geometry change
    // note: both current and history are sample from half resolution buffer
    float4 historyNormalDepth = _NormalDepthHistory.SampleLevel(sampler_PointClamp, reprojectUV, 0);
    float3 historyNormal = historyNormalDepth.xyz * 2 - 1;
    float historySceneDepth = ConvertFromDeviceZ(historyNormalDepth.w);

    float4 currentNormalDepth = _NormalDepthTexture.SampleLevel(sampler_PointClamp, currentUV, 0);
    float3 currentNormal = currentNormalDepth.xyz * 2 - 1;
    float currentSceneDepth = ConvertFromDeviceZ(currentNormalDepth.w);

    float historyWeight = _TemporalFilterWeight;
    if (IsUVOutSideScreen(reprojectUV) || dot(historyNormal, currentNormal) < 0.5 || abs(historySceneDepth - currentSceneDepth) > 1)
    {
        historyWeight = 0;
    }

    return float4(historyColor, historyWeight);
}

[numthreads(8, 8, 1)]
void SpecularTemporalFilter(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    // 1. setup
    const float2 sceneTextureTexelSize = 1.0 / float2(_SceneTextureRTSize);
    const int2 pixelCoord = clamp(threadId.xy, 0, _SceneTextureRTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_SceneTextureRTSize);
    if (any(threadId.xy >= _SceneTextureRTSize))
    {
        return;
    }
    
    float rawDepth = _SceneDepthTexture.SampleLevel(sampler_PointClamp, uv, 0);
    float3 worldPosition = ReconstructWorldPositionFromDepth(uv, rawDepth);
    
    float4 GBufferNormalRoughness = _GBufferNormal.SampleLevel(sampler_PointClamp, uv, 0);
    float linearRoughness = sqrt(GBufferNormalRoughness.w);

    if (IsUVOutSideScreen(uv) || rawDepth <= 0)
    {
        _RWSpecularTemporalFilterOutput[pixelCoord] = float4(0, 0, 0, 0);
        return;
    }

    // 2. sample current frame color
    float4 colorSamples[9];
    for (int i = 0; i < 9; i++)
    {
        float2 neighborUV = uv + offsets3x3[i] * sceneTextureTexelSize;
        colorSamples[i] = ClampNaNs(_SpecularIndirectTexture.SampleLevel(sampler_PointClamp, neighborUV, 0));
    }
    float3 currentColor = colorSamples[0].rgb;
    float currentRayDistance = colorSamples[0].w;

    // 3. reproject pixel using surface position
    float4 surfaceReprojectResult = SpecularIndirectFetchHistory(worldPosition, uv);
    surfaceReprojectResult.rgb = ClampHistory(colorSamples, currentColor, surfaceReprojectResult.rgb, _HistoryColorBoundScale);

    // 4. reproject pixel using ray distance parallex
    float3 viewDirection = normalize(worldPosition - _CameraPosition);
    float3 mirroredHitPoint = worldPosition + viewDirection * currentRayDistance;
    float4 parallexReprojectResult = SpecularIndirectFetchHistory(mirroredHitPoint, uv);
    parallexReprojectResult.rgb = ClampHistory(colorSamples, currentColor, parallexReprojectResult.rgb, _HistoryColorBoundScale);
    
    // 5. mix two reprojection methods based on pixel roughness
    float3 filteredColorWithSurfaceReproject = lerp(currentColor, surfaceReprojectResult.rgb, surfaceReprojectResult.a);
    float3 filteredColorWithParallexReproject = lerp(currentColor, parallexReprojectResult.rgb, parallexReprojectResult.a);
    float3 filteredColor = lerp(filteredColorWithParallexReproject, filteredColorWithSurfaceReproject, linearRoughness);

    _RWSpecularTemporalFilterOutput[pixelCoord] = float4(filteredColor, 1);
}

// -------------------------------------------------------------------------------- //
#pragma kernel SpecularSpatialFilter

RWTexture2D<float4> _RWSpecularSpatialFilterOutput;

[numthreads(8, 8, 1)]
void SpecularSpatialFilter(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    // 1. setup
    const float2 texelSize = 1.0 / float2(_RTSize);
    const int2 pixelCoord = clamp(threadId.xy, 0, _RTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_RTSize);
    if (any(threadId.xy >= _RTSize))
    {
        return;
    }
    
    uint2 randomSeed = Rand3DPCG16(uint3(uv * 256, _FrameNumber + 1024)).xy;
    float rawDepth = _SceneDepthTexture.SampleLevel(sampler_PointClamp, uv, 0);
    float sceneDepth = ConvertFromDeviceZ(rawDepth);
    float4 GBufferNormalRoughness = _GBufferNormal.SampleLevel(sampler_PointClamp, uv, 0);

    if (IsUVOutSideScreen(uv) || rawDepth <= 0)
    {
        _RWSpecularSpatialFilterOutput[pixelCoord] = float4(0, 0, 0, 0);
        return;
    }

    // 2. filter current frame output
    int sampleCount = 8;
    float weightSum = 0;
    float4 colorSum = 0;
    float searchRange = texelSize * _FilterRadius * lerp(1e-3, 4, GBufferNormalRoughness.w);

    for (int i = 0; i < sampleCount; i++)
    {
        float2 E = Hammersley16(i, sampleCount, randomSeed);
        float2 uvOffset = UniformSampleDisk(E); // [-1 ~ 1]
        float2 neighborUV = uv + uvOffset * searchRange;

        if (IsUVOutSideScreen(neighborUV))
        {
            continue;
        }

        float4 neighborColor = _SpecularIndirectTexture.SampleLevel(sampler_linearClamp, neighborUV, 0);
        neighborColor = ClampNaNs(neighborColor);

#if RADIANCE_TONEMAPPING
        neighborColor = neighborColor / (1.0 + Luma(neighborColor));
#endif

        float neighborDepth = ConvertFromDeviceZ(_SceneDepthTexture.SampleLevel(sampler_PointClamp, neighborUV, 0));
        float3 neighborNormal = _GBufferNormal.SampleLevel(sampler_PointClamp, neighborUV, 0).xyz;

        // float Weight = 1.0;
        float weight = exp(-length(neighborUV - uv) / searchRange);
        weight *= exp(-abs(neighborDepth - sceneDepth) * 0.01);
        weight *= saturate(dot(neighborNormal, GBufferNormalRoughness.xyz));

        colorSum += neighborColor * weight;
        weightSum += weight;
    }

    float3 color = (weightSum > 0) ? (colorSum.rgb / weightSum) : 0;

#if RADIANCE_TONEMAPPING
    color = color / (1.0 - Luma(color));
#endif

    _RWSpecularSpatialFilterOutput[pixelCoord] = float4(color, 1);
}

// -------------------------------------------------------------------------------- //
#pragma kernel SpecularComposite

RWTexture2D<float4> _RWSpecularCompositeTexture;

[numthreads(8, 8, 1)]
void SpecularComposite(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    float2 sceneTextureTexelSize = rcp(float2(_SceneTextureRTSize));
    const int2 pixelCoord = clamp(threadId.xy, 0, _SceneTextureRTSize - 1);
    const float2 uv = (float2(pixelCoord) + 0.5) / float2(_SceneTextureRTSize);
    if (any(threadId.xy >= _SceneTextureRTSize))
    {
        return;
    }
    float rawDepth = _SceneDepthTexture.SampleLevel(sampler_PointClamp, uv, 0);
    
    float4 GBufferNormalRoughness = _GBufferNormal.SampleLevel(sampler_PointClamp, uv, 0);
    float3 GBufferSpecular = _GBufferSpecular.SampleLevel(sampler_PointClamp, uv, 0);
    
    float3 worldPosition = ReconstructWorldPositionFromDepth(uv, rawDepth);
    float3 irradiance = _SpecularIndirectTexture.SampleLevel(sampler_linearClamp, uv, 0).rgb;

#if APPLY_BRDF_AFTER_TAA
    float3 V = normalize(_CameraPosition - worldPosition);
    float NoV = saturate(dot(GBufferNormalRoughness.xyz, V));
    float3 preIntegratedGF = EnvBRDF(GBufferSpecular, GBufferNormalRoughness.w, NoV);
    float3 specularIndirect = irradiance * preIntegratedGF;
#else
    float3 specularIndirect = irradiance;
#endif

    _RWSpecularCompositeTexture[pixelCoord] = float4(specularIndirect, 1);
}