#include "../RayTracing/VoxelRayTracing.hlsl"
#pragma kernel VisualizeClipmap

float4 _ScreenResolution;
float4 _CameraPosition;
float4x4 _InvViewProjMat;

int _VisualizeMode;
int _VisualizeCascadeLevel;
int _VisualizeUpdateChunk;
int _CascadeCount;
int3 _VoxelPageCountInXYZ;
int3 _CascadeResolution;

float3 _CascadeCenterArray[MAX_CASCADE_COUNT];
float3 _CascadeSizeArray[MAX_CASCADE_COUNT];
int3 _CascadeMoveOffsetArray[MAX_CASCADE_COUNT];

Texture3D<uint2> _BitOccupyClipmap;
Texture3D<int> _VoxelPageClipmap;
Texture3D<float4> _VoxelPoolBaseColor;
Texture3D<float4> _VoxelPoolNormal;
Texture3D<float4> _VoxelPoolEmissive;
Texture3D<float4> _VoxelPoolRadiance;

Texture2D<float> _SceneDepthTexture;
RWTexture2D<float4> _RWSceneColorTexture;

Texture3D<float> _VoxelOccupy;

int _UpdateChunkCount;
float3 _UpdateChunkResolution;
StructuredBuffer<int> _UpdateChunkList;

SamplerState sampler_LinearClamp;

float3 ReconstructWorldPositionFromDepth(float2 uv, float depth)
{
    float2 ndcPosition = float2((uv.x - 0.5f) * 2.0f, (uv.y - 0.5f) * 2.0f);
    float realDepth = depth;
    float4 worldPosition = mul(_InvViewProjMat, float4(ndcPosition * realDepth, realDepth, 1.0f));
    return worldPosition.xyz / worldPosition.w;
}

[numthreads(8, 8, 1)]
void VisualizeClipmap(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    uint2 pixelCoord = threadId.xy;
    if (pixelCoord.x >= _ScreenResolution.x || pixelCoord.y >= _ScreenResolution.y)
    {
        return;
    }

    float2 uv = (float2(pixelCoord) + 0.5) / _ScreenResolution.xy;
    float rawDepth = _SceneDepthTexture.Load(int3(pixelCoord, 0)).r;
    float pixelDepth = (1.0 - rawDepth) * 2.0 - 1.0;
    float3 pixelWorldPosition = ReconstructWorldPositionFromDepth(uv, pixelDepth);
    
    float3 rayDir = normalize(pixelWorldPosition - _CameraPosition.xyz);
    float3 rayEnd = rayDir * 1000000 + _VoxelOccupy[uint3(0, 0, 0)];
    float3 color = float3(0, 0, 0);

    ClipmapInfo clipmapInfo = (ClipmapInfo) 0;
    clipmapInfo.cascadeCount = _CascadeCount;
    clipmapInfo.cascadeResolution = _CascadeResolution;
    clipmapInfo.cascadeCenterArray = _CascadeCenterArray;
    clipmapInfo.cascadeSizeArray = _CascadeSizeArray;
    clipmapInfo.cascadeMoveOffsetArray = _CascadeMoveOffsetArray;
    
    VoxelRaytracingRequest RTRequest = (VoxelRaytracingRequest) 0;
    RTRequest.rayStart = _CameraPosition;
    RTRequest.rayDir = rayDir;
    RTRequest.minCascadeIndex = clamp(_VisualizeCascadeLevel, 0, _CascadeCount - 1);
    RTRequest.maxCascadeIndex = _CascadeCount - 1;
    RTRequest.maxStepNum = 128000;
    RTRequest.maxDistance = 200000000;
    
    VoxelRayTracingHitPayload hit = VoxelRaytracing(clipmapInfo, _BitOccupyClipmap, RTRequest);
    
    if (hit.isHit)
    {
        float3 debugColor = float3(0, 0, 0);
        int voxelPageId = _VoxelPageClipmap.Load(uint4(hit.clipmapAccessIndex, 0)).r;
        
        if (voxelPageId != PAGE_ID_INVALID)
        {
            int3 indexInPool = PageAddressMapping(voxelPageId, _VoxelPageCountInXYZ, hit.voxelIndex);
            
            if (_VisualizeMode == 1)  // base color
            {
                debugColor = _VoxelPoolBaseColor.Load(uint4(indexInPool, 0)).rgb;
            }
            if (_VisualizeMode == 2)  // normal
            {
                debugColor = _VoxelPoolNormal.Load(uint4(indexInPool, 0)).rgb;
            }
            if (_VisualizeMode == 3)  // emissive
            {
                debugColor = _VoxelPoolEmissive.Load(uint4(indexInPool, 0)).rgb;
            }
            if (_VisualizeMode == 4)  // radiance
            {
                float3 worldNormal = _VoxelPoolNormal.Load(uint4(indexInPool, 0)).rgb * 2 - 1;
                int isBackFace = dot(worldNormal, -rayDir) < 0;
                int3 twoSideIndex = TwoSideAddressMapping(indexInPool, isBackFace);
                debugColor = _VoxelPoolRadiance.Load(uint4(twoSideIndex, 0)).rgb;
            }
        }
        // for invalid page maybe runout of space, we just give it a warning color
        else
        {
            debugColor = float3(1, 0, 1);
        }
        
        color += debugColor;
    }
    
    if (_VisualizeUpdateChunk > 0)
    {
        //int cascadeIndex = _VisualizeUpdateChunk - 1;
        //for (int i = 0; i < _UpdateChunkCount; i++)
        //{
        //    int3 chunkNumXYZ = _CascadeResolution / _UpdateChunkResolution;
        //    int chunkId_1D = _UpdateChunkList[i];
        //    float3 chunkId_3D = Index1DTo3D(chunkId_1D, chunkNumXYZ);
        //    float3 chunkCenter = CalcVoxelCenterPos(chunkId_3D, chunkNumXYZ, _CascadeCenterArray[cascadeIndex], _CascadeSizeArray[cascadeIndex]);
        //    float3 chunkCoverRange = _CascadeSizeArray[cascadeIndex] * _UpdateChunkResolution / _CascadeResolution;

        //    float3 boxMin = chunkCenter - chunkCoverRange * 0.5;
        //    float3 boxMax = chunkCenter + chunkCoverRange * 0.5;
        //    float2 hitChunkT = LineBoxIntersect(_CameraPosition, rayEnd, boxMin, boxMax);
        //    if (hitChunkT.x < hitChunkT.y)
        //    {
        //        color += float3(0, 0.5, 0.8);
        //    }
        //}
    }

    _RWSceneColorTexture[pixelCoord] = float4(color, 1);
}