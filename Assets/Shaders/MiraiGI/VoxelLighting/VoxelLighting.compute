#include "../../GICommon.hlsl"
#include "../RayTracing/VoxelRayTracing.hlsl"

#pragma kernel PickValidVoxel

int _CascadeIndex;
int3 _CascadeResolution;
int3 _CascadeMoveOffset;
int4 _CheckerBoardInfo;

Texture3D<uint2> _VoxelBitOccupyClipmap;
RWStructuredBuffer<int> _RWValidVoxelCounter;
RWStructuredBuffer<int> _RWValidVoxelBuffer;

groupshared int gs_ThreadVoxelCounter[64];
groupshared int gs_ThreadWriteIndex[64];

[numthreads(4, 4, 4)]
void PickValidVoxel(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    int groupThreadIndex = Index3DTo1D(groupThreadId, int3(4, 4, 4));

    // one thread for one block, use checker board 2x2x2 for average update to 8 frame
    int3 blockIndex = threadId.xyz * _CheckerBoardInfo.w + _CheckerBoardInfo.xyz;
    int3 voxelIndexBase = blockIndex * VOXEL_BLOCK_SIZE;
    int3 clipmapAccessIndex = ClipmapAddressMapping(voxelIndexBase, _CascadeResolution, _CascadeMoveOffset, _CascadeIndex);
    uint2 bitOccupy = _VoxelBitOccupyClipmap[clipmapAccessIndex];

    // 1. count valid voxel
    int voxelCounter = BitCount32(bitOccupy.x) + BitCount32(bitOccupy.y);
    gs_ThreadVoxelCounter[groupThreadIndex] = voxelCounter;

    GroupMemoryBarrierWithGroupSync();

    // 2. allocate space in RWValidVoxelBuffer, boardcast write index to thread
    if (groupThreadIndex == 0)
    {
        int groupVoxelCounter = 0;
        for (int i = 0; i < 64; i++)
        {
            groupVoxelCounter += gs_ThreadVoxelCounter[i];
        }

        int startIndex;
        InterlockedAdd(_RWValidVoxelCounter[0], groupVoxelCounter, startIndex);

        for (int i = 0; i < 64; i++)
        {
            gs_ThreadWriteIndex[i] = startIndex;
            startIndex += gs_ThreadVoxelCounter[i];
        }
    }

    GroupMemoryBarrierWithGroupSync();

    // 3. write voxel index to buffer
    int writeIndex = gs_ThreadWriteIndex[groupThreadIndex];
    for (int i = 0; i < VOXEL_COUNT_PER_BLOCK; i++)
    {
        bool hasVoxel = GetUint64SingleBit(bitOccupy, i);
        if (hasVoxel)
        {
            int3 voxelIndex = voxelIndexBase + Index1DTo3D_4x4x4(i);
            int voxelIndex1D = Index3DTo1D(voxelIndex, _CascadeResolution);
            _RWValidVoxelBuffer[writeIndex] = voxelIndex1D;
            writeIndex += 1;
        }
    }
}

// -------------------------------------------------------------------------------- //
#pragma kernel BuildVoxelLightingIndirectArgs

int _ThreadsCountForVoxelLighting;

StructuredBuffer<int> _ValidVoxelCounter;
RWStructuredBuffer<int> _RWIndirectArgs;

[numthreads(1, 1, 1)]
void BuildVoxelLightingIndirectArgs(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    _RWIndirectArgs[0] = ceil(float(_ValidVoxelCounter[0]) / float(_ThreadsCountForVoxelLighting));
    _RWIndirectArgs[1] = 1;
    _RWIndirectArgs[2] = 1;
}

// -------------------------------------------------------------------------------- //
#pragma kernel VoxelLighting

int3 _VoxelPageCountInXYZ;
int _CascadeCount;
float3 _CascadeCenterArray[MAX_CASCADE_COUNT];
float3 _CascadeSizeArray[MAX_CASCADE_COUNT];
int3 _CascadeMoveOffsetArray[MAX_CASCADE_COUNT];

float4x4 _CameraViewProjectionMatrix;
float3 _MainLightDirection;
float4 _MainLightColor;
float _ShadowRayMaxDistance;
int _ShadowRayBoostClipmapOffset;
int _CSMNumCascades;
float4 _CSMShadowBounds[4];
float4x4 _CSMWorldToShadowMatrices[4];

StructuredBuffer<int> _ValidVoxelBuffer;

SamplerState sampler_PointClamp;

Texture2D<float> _ShadowDepthTexture;
Texture3D<int> _VoxelPageClipmap;
Texture3D<float4> _VoxelPoolBaseColor;
Texture3D<float4> _VoxelPoolNormal;
Texture3D<float4> _VoxelPoolEmissive;

RWTexture3D<float3> _RWVoxelPoolRadiance;

ClipmapInfo ResolveClipmapInfo()
{
    ClipmapInfo clipmapInfo = (ClipmapInfo) 0;
    clipmapInfo.cascadeCount = _CascadeCount;
    clipmapInfo.cascadeResolution = _CascadeResolution;
    clipmapInfo.cascadeCenterArray = _CascadeCenterArray;
    clipmapInfo.cascadeSizeArray = _CascadeSizeArray;
    clipmapInfo.cascadeMoveOffsetArray = _CascadeMoveOffsetArray;
    
    return clipmapInfo;
}

[numthreads(8, 1, 1)]
void VoxelLighting(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    if (threadId.x >= _ValidVoxelCounter[0])
    {
        return;
    }
    
    ClipmapInfo clipmapInfo = ResolveClipmapInfo();
    CascadeInfo cascadeInfo = ResolveCascadeInfo(clipmapInfo, _CascadeIndex);

    // 1. read page data, note that 4x4x4 voxel in same block will share 4x4x4 page data in pool
    int voxelIndex1D = _ValidVoxelBuffer[threadId.x];
    int3 voxelIndex = Index1DTo3D(voxelIndex1D, _CascadeResolution);
    int3 clipmapAccessIndex = ClipmapAddressMapping(voxelIndex, _CascadeResolution, cascadeInfo.moveOffset, _CascadeIndex);
    int voxelPageId = _VoxelPageClipmap.Load(uint4(clipmapAccessIndex, 0)).r;

    if (voxelPageId == PAGE_ID_INVALID)
    {
        return;
    }
    
    // 2. read surface attribute
    int3 indexInPool = PageAddressMapping(voxelPageId, _VoxelPageCountInXYZ, voxelIndex);
    float3 baseColor = _VoxelPoolBaseColor.Load(int4(indexInPool, 0));
    float3 worldNormal = _VoxelPoolNormal.Load(int4(indexInPool, 0)) * 2 - 1;
    float3 emissive = _VoxelPoolEmissive.Load(int4(indexInPool, 0));

    // 3. evaluate directional light shadow
    float mainLightShadow = 1.0;
    float3 voxelPosition = CalcVoxelCenterPos(voxelIndex, _CascadeResolution, cascadeInfo.center, cascadeInfo.size);
    float3 voxelClipPosition = mul(_CameraViewProjectionMatrix, float4(voxelPosition, 1));
    voxelClipPosition.xyz /= voxelClipPosition.b;
    bool isVoxelInFrustum = all(abs(voxelClipPosition.xy) < 1) && voxelClipPosition.z > 0; // voxel may behind camera frustum where csm is invalid

    // 3.1. use whole scene shadow map
    for (int cascadeIndex = 0; cascadeIndex < _CSMNumCascades; cascadeIndex++)
    {
        float4 boundSphere = _CSMShadowBounds[cascadeIndex];
        if (length(voxelPosition - boundSphere.xyz) > boundSphere.w || !isVoxelInFrustum)
        {
            continue;
        }
        
        //float4 shadowPosition = mul(float4(voxelPosition, 1), _CSMWorldToShadowMatrixs[cascadeIndex]);
        float4 shadowPosition = mul(_CSMWorldToShadowMatrices[cascadeIndex], float4(voxelPosition, 1));
        shadowPosition.xyz /= shadowPosition.w;
        shadowPosition.y = 0.5f - shadowPosition.y;
        shadowPosition.z = (shadowPosition.z * 0.5f) + 0.5f;
        float sampleZ = _ShadowDepthTexture.SampleLevel(sampler_PointClamp, shadowPosition.xy, 0).r;
        mainLightShadow *= (shadowPosition.z >= sampleZ);
    }

    // 3.2. trace shadow ray as fallback
    if (!isVoxelInFrustum)
    {
        int rayBoostClipmapOffset = _CascadeIndex < (MAX_CASCADE_COUNT / 2) ? _ShadowRayBoostClipmapOffset : 0;
        float3 positionOffset = worldNormal * cascadeInfo.voxelSize * (1 << rayBoostClipmapOffset); // offset 1 voxel to avoid self shadow

        VoxelRaytracingRequest RTRequest = (VoxelRaytracingRequest) 0;
        RTRequest.rayStart = voxelPosition + positionOffset;
        RTRequest.rayDir = _MainLightDirection;
        RTRequest.maxCascadeIndex = _CascadeCount - 1;
        RTRequest.minCascadeIndex = min(cascadeIndex + rayBoostClipmapOffset, RTRequest.maxCascadeIndex);
        RTRequest.maxStepNum = 128000;
        RTRequest.maxDistance = _ShadowRayMaxDistance;

        VoxelRayTracingHitPayload hit = VoxelRaytracing(clipmapInfo, _VoxelBitOccupyClipmap, RTRequest);
        mainLightShadow = hit.isHit ? 0 : 1;
    }

    // 4. evaluate direct lighting
    for (int face = VOXEL_FACE_FRONT; face <= VOXEL_FACE_BACK; face++)
    {
        float3 radiance = emissive;
        float3 faceNormal = worldNormal * lerp(1, -1, face); // -WorldNormal if back face

        radiance += saturate(dot(faceNormal, _MainLightDirection)) * _MainLightColor * mainLightShadow * baseColor / (3.1415926);

        int3 writeIndex = TwoSideAddressMapping(indexInPool, face);
        _RWVoxelPoolRadiance[writeIndex] = radiance;
    }    
}

// -------------------------------------------------------------------------------- //
#pragma kernel FarFieldProbeGather

int _ProbeResolution;
int3 _ProbeCountInXYZ;
int2 _ProbeCountInAtlasXY;
float _MaxRayDistance;

Texture3D<float3> _VoxelPoolRadiance;
RWTexture2D<float3> _RWFarFieldProbeAtlas;

int2 RedirectBorderPixel(int2 pixelIndexInProbe)
{
    int2 result = pixelIndexInProbe;
    int pixelIndexMax = _ProbeResolution - 1; // 15

    // row
    if (pixelIndexInProbe.y == 0 || pixelIndexInProbe.y == pixelIndexMax)
    {
        result.x = pixelIndexMax - pixelIndexInProbe.x;
        result.y += (pixelIndexInProbe.y == 0) ? 1 : -1; // top or bottom row
    }
    // col
    if (pixelIndexInProbe.x == 0 || pixelIndexInProbe.x == pixelIndexMax)
    {
        result.x += (pixelIndexInProbe.x == 0) ? 1 : -1; // left or right col
        result.y = pixelIndexMax - pixelIndexInProbe.y;
    }

    // left top
    if (pixelIndexInProbe.x == 0 && pixelIndexInProbe.y == 0)
    {
        result = int2(pixelIndexMax - 1, pixelIndexMax - 1);
    }
    // right top
    if (pixelIndexInProbe.x == pixelIndexMax && pixelIndexInProbe.y == 0)
    {
        result = int2(1, pixelIndexMax - 1);
    }
    // left bottom
    if (pixelIndexInProbe.x == 0 && pixelIndexInProbe.y == pixelIndexMax)
    {
        result = int2(pixelIndexMax - 1, 1);
    }
    // right bottom
    if (pixelIndexInProbe.x == pixelIndexMax && pixelIndexInProbe.y == pixelIndexMax)
    {
        result = int2(1, 1);
    }

    return result;
}

[numthreads(8, 8, 1)]
void FarFieldProbeGather(uint3 threadId : SV_DispatchThreadID, uint3 groupThreadId : SV_GroupThreadID, uint3 groupId : SV_GroupID)
{
    ClipmapInfo clipmapInfo = ResolveClipmapInfo();
    CascadeInfo cascadeInfo = ResolveCascadeInfo(clipmapInfo, _CascadeIndex);

    // use checker board 2x2x2 for average update to 8 frame
    int3 probeIndex3D = int3(threadId.xy / _ProbeResolution, threadId.z);
    probeIndex3D = probeIndex3D * _CheckerBoardInfo.w + _CheckerBoardInfo.xyz;
    float3 probeLocation = CalcVoxelCenterPos(probeIndex3D, _ProbeCountInXYZ, cascadeInfo.center, cascadeInfo.size);

    // 1. calculate octahedral uv and ray direction
    int2 pixelIndexInProbe = threadId.xy % _ProbeResolution; // [0 ~ 16]
    int2 pixelIndexRedirect = RedirectBorderPixel(pixelIndexInProbe);
    
    float2 probeUV = float2(pixelIndexRedirect - 1) / float(_ProbeResolution - 2); // [0 ~ 1], 2 is for padding
    probeUV += 0.5 / float(_ProbeResolution - 2); // align to texel center
    float3 rayDirection = OctahedralDirection(probeUV);

    // trace ray
    VoxelRaytracingRequest RTRequest = (VoxelRaytracingRequest) 0;
    RTRequest.rayStart = probeLocation;
    RTRequest.rayDir = rayDirection;
    RTRequest.minCascadeIndex = _CascadeIndex;
    RTRequest.maxCascadeIndex = _CascadeCount - 1;
    RTRequest.maxStepNum = 128000;
    RTRequest.maxDistance = _MaxRayDistance;

    VoxelRayTracingHitPayload hit = VoxelRaytracing(clipmapInfo, _VoxelBitOccupyClipmap, RTRequest);

    // 3. fetch radiance
    float3 hitRadiance = float3(0, 0, 0);
    if (hit.isHit)
    {
        int voxelPageId = _VoxelPageClipmap.Load(uint4(hit.clipmapAccessIndex, 0)).r;
        if (voxelPageId != PAGE_ID_INVALID)
        {
            int3 indexInPool = PageAddressMapping(voxelPageId, _VoxelPageCountInXYZ, hit.voxelIndex);

            float3 worldNormal = _VoxelPoolNormal.Load(uint4(indexInPool, 0)).rgb * 2 - 1;
            int isBackFace = dot(worldNormal, -RTRequest.rayDir) < 0;

            int3 twoSideIndex = TwoSideAddressMapping(indexInPool, isBackFace);
            hitRadiance = _VoxelPoolRadiance.Load(uint4(twoSideIndex, 0)).rgb;
        }
    }
    else
    {
        // TODO: sample skybox
        hitRadiance = float3(1, 1, 1);
    }

    // 4. write to probe atlas
    int2 writeOffset = GetProbePixelOffsetInAtlas(probeIndex3D, _ProbeCountInXYZ, _ProbeCountInAtlasXY, _ProbeResolution);
    int2 writeIndex = writeOffset + pixelIndexInProbe;
    
    _RWFarFieldProbeAtlas[writeIndex] = hitRadiance;
}